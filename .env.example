# SignalForge Environment Configuration Example
# Copy this file to .env for local serverless testing.
# NEVER commit production API keys or credentials to version control.

# Optional: Google Gemini API key for online AI Tutor fallback (Level 2 Chatbot)
# If omitted or unconfigured, SignalForge automatically runs 100% offline
# using the local knowledge base at data/knowledge.json (Level 1 Chatbot).
GEMINI_API_KEY=""

# Local Port Configuration
PORT=8000
